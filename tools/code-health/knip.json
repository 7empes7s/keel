{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "cli/*.mjs",
    "tools/**/*.mjs",
    "status/generate.mjs",
    "{engine,cli,tools,status}/**/*.test.mjs",
    "portal/app/**/{page,layout,route,loading,error,not-found,global-error,template,default,icon,opengraph-image,sitemap,robots,manifest}.{ts,tsx}",
    "portal/{proxy,instrumentation,next.config}.ts",
    "portal/test/**/*.ts",
    "portal/ui-harness/build.mjs",
    "portal/ui-harness/playwright.config.ts",
    "portal/ui-harness/**/*.spec.ts",
    "portal/ui-harness/shims/*.{ts,tsx}"
  ],
  "project": ["{engine,cli,tools,status}/**/*.mjs", "portal/**/*.{ts,tsx,mjs}"],
  "ignore": ["**/coverage-fixtures/**", "portal/next-env.d.ts"],
  "ignoreDependencies": [".*"],
  "ignoreBinaries": [".*"],
  "include": ["files", "exports", "types", "duplicates"]
}
