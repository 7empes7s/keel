{
  "permissions": {
    "allow": [
      "mcp__claude-code-remote__update_trigger",
      "mcp__claude-code-remote__send_message",
      "Bash(gh api repos/7empes7s/keel/issues/*/labels*)",
      "mcp__github__issue_write"
    ],
    "deny": [
      "Bash(gh api -X PUT repos/7empes7s/keel/pulls/*/merge*)",
      "Bash(gh pr merge*)",
      "mcp__github__merge_pull_request",
      "mcp__github__enable_pr_auto_merge"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"${CLAUDE_CODE_REMOTE:-}\" = \"true\" ]; then \"$CLAUDE_PROJECT_DIR/tools/dev-setup.sh\"; fi",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
