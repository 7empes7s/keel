# ops/keel-worker.service
# Install with ops/keel-schedules-install.sh --root <deployed tree>, which rewrites the
# /opt/keel paths below to that tree. Copied as-is, this unit would run the old /opt/keel checkout.
[Unit]
Description=KEEL job worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/keel/db.env
ExecStart=/usr/bin/node /opt/keel/cli/keel-worker.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=keel-worker

[Install]
WantedBy=multi-user.target
