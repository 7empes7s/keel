# ops/keel-worker.service
# ops/keel-schedules-install.sh --root DIR rewrites /opt/keel-live to DIR when it installs this unit.
[Unit]
Description=KEEL job worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/keel/db.env
ExecStart=/usr/bin/node /opt/keel-live/cli/keel-worker.mjs
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=keel-worker

[Install]
WantedBy=multi-user.target
