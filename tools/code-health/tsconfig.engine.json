{
  "//": "Type information for linting the Node ESM code (engine/, cli/, tools/, status/). Lint only: nothing is type-checked or emitted.",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["../../engine/**/*.mjs", "../../cli/**/*.mjs", "../../tools/**/*.mjs", "../../status/**/*.mjs"],
  "exclude": ["../../**/node_modules/**"]
}
